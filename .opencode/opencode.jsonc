{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    // 火山方舟 Coding Plan — OpenAI 兼容端点
    // 文档: https://www.volcengine.com/docs/82379/1928261
    // Base URL 必须使用 /api/coding/v3，否则会消耗普通 API 额度而非 Coding Plan 套餐
    "volcengine-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "火山方舟 Coding Plan",
      "env": ["VOLCENGINE_API_KEY"],
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3",
      },
      "models": {
        "ark-code-latest": {
          "name": "Ark Code Latest（控制台切换）",
          "tool_call": true,
          "limit": { "context": 256000, "output": 32000 },
        },
        "doubao-seed-2.0-code": {
          "name": "Doubao Seed 2.0 Code",
          "tool_call": true,
          "limit": { "context": 256000, "output": 32000 },
        },
        "doubao-seed-code": {
          "name": "Doubao Seed Code",
          "tool_call": true,
          "limit": { "context": 256000, "output": 32000 },
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "tool_call": true,
          "limit": { "context": 256000, "output": 32000 },
        },
        "kimi-k2-thinking": {
          "name": "Kimi K2 Thinking",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 256000, "output": 32000 },
        },
        "glm-4.7": {
          "name": "GLM 4.7",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 },
        },
        "deepseek-v3.2": {
          "name": "DeepSeek V3.2",
          "tool_call": true,
          "limit": { "context": 128000, "output": 32000 },
        },
      },
    },
  },
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
